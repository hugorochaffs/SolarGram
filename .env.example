# ==========================================
# Configurações do Monitor APsystems
# ==========================================

# IP da sua ECU APsystems na rede local
ECU_IP=192.168.xxx.xxx

# Porta TCP padrão da ECU (8899)
ECU_PORT=8899

# ID Único da ECU (Exemplo: 200000000). Se deixar em branco, o sistema tentará auto-detectar.
ECU_ID=000000000000

# Intervalo entre leituras em segundos (Padrão: 120 = 2 minutos)
POLL_INTERVAL_SECONDS=120

# Horário diário para envio do relatório completo ao Telegram (Formato 24h: HH:MM)
REPORT_TIME=18:00

# ==========================================
# Configurações do Bot do Telegram
# ==========================================

# Token do seu Bot do Telegram fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=SEU_TELEGRAM_BOT_TOKEN_AQUI

# ID da sua conversa ou grupo no Telegram (Obtenha via @userinfobot ou @raw_data_bot)
TELEGRAM_CHAT_ID=SEU_TELEGRAM_CHAT_ID_AQUI

# Enviar notificação imediatamente se a conexão com a ECU falhar? (true/false)
TELEGRAM_ALERT_ON_FAILURE=true

# Tempo de espera em minutos para não repetir alertas de falha continuamente
ALERT_COOLDOWN_MINUTES=60
